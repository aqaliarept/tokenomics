      "floors": {
        "atlas_per_world": "SE_w = atlas.standard_error(n_w episodes, differing_w, the compared stochastic arms at their R, the atlas v2 `spreads` of the world's size / choice stratum); floor_w = max(3 SE_w, 0.01 bar_w)",
