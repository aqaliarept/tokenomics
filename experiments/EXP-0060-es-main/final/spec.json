        "floor_se": 3.0,
        "min_own_pairs": 2,
        "monitor_strata": "a monitor world-episode is its own world (1 episode, R = 2), stratum (12, its choice), differing from its pattern / shocks",
        "own_per_world": "3 * stdev(paired observations) / sqrt(count), paired per episode and replicate (same replicates pair by replicate, a deterministic arm's one row against each replicate); only with >= 2 paired observations on the world (the n = 1 rule), else the atlas floor alone",
        "own_world_mean": "3 sqrt(sum_w s^2 / n_w) / W, s^2 the pooled within-world variance of the paired observations over the worlds with >= 2 of them (df = sum (n_w - 1)); none when no world has 2 (the n = 1 rule)",
        "rule": "per comparison (candidate vs A0, RR, MWW, TR and its shared-only ablation; A2 vs A1; center vs A0 on the monitor set): max(atlas-spread floor at the read's counts, own 3 SE)",
